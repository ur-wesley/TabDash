---
import type { MarkdownInstance } from 'astro';

const FILE_NAME_SEGMENT_OFFSET = 1,
 URL_TITLE_SEGMENT_OFFSET = 1;

interface Props {
  settings: MarkdownInstance<Record<string, unknown>>[];
}

const { settings } = Astro.props,
 urlParts = Astro.url.toString().split('/'),
 title = urlParts.at(-URL_TITLE_SEGMENT_OFFSET);
---

<aside>
  <ul>
    {
      settings
        .sort((left, right) => left.frontmatter.title - right.frontmatter.title)
        .map((page) => {
          if (!page.frontmatter.title) return;
          const urlSegments = page.url?.split('/') ?? [];
          const file = urlSegments.at(-FILE_NAME_SEGMENT_OFFSET) ?? '';
          let itemClass = '';
          if (file.replace('.md', '').toLowerCase() === title?.toLowerCase()) {
            itemClass = 'active';
          }
          return (
            <a href={page.url}>
              <li class={itemClass}>
                {page.frontmatter.title}
              </li>
            </a>
          );
        })
    }
  </ul>
</aside>
<style>
  aside {
    height: calc(100vh - 4rem);
    overflow: auto;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
  }
  ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 1rem 0;
    padding: 0;
    max-width: max-content;
  }
  li {
    list-style: none;
    background-color: slategray;
    padding: 0.4rem 1.2rem;
    border-radius: 8px;
    color: white;
    cursor: pointer;
    transition: all 300ms;
    border: 2px solid transparent;
    box-sizing: border-box;
  }
  a {
    text-decoration: none;
    color: white;
  }
  li:hover {
    background-color: cornflowerblue;
  }
  .active {
    background-color: transparent;
    border: 2px solid slategray;
    color: slategray;
  }
  .active:hover {
    border: 2px solid transparent;
    color: white;
  }
</style>

export type { Props };
