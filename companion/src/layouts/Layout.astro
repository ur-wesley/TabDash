---
import GeneralMenu from "../components/GeneralMenu";
import HelpMenu from "../components/HelpMenu.astro";
import "../components/styles/index.scss";

const DOC_LANG_PATH_INDEX = 4,
 DOC_LANG_SEGMENT_OFFSET = 2,
 PREV_STEP = 1,
 NO_MATCH_INDEX = -1,

 { frontmatter } = Astro.props,
 onlineVersion =
  import.meta.env.PUBLIC_ONLINE_BASE ?? 'https://online.tabdash.wesley.fyi',
 urlParts = Astro.url.toString().split("/"),
 allSettings = await Astro.glob("../pages/docs/**/*.md"),
 settings = allSettings.filter((setting) => {
  const pathSegments = setting.file?.split("/") ?? [],
   docLang = pathSegments.at(-DOC_LANG_SEGMENT_OFFSET);
  return docLang === urlParts[DOC_LANG_PATH_INDEX] && setting.frontmatter.title;
 }),
 currentIndex = settings.findIndex(
  (entry) => entry.frontmatter.title === frontmatter.title
 );
let prev;
if (currentIndex - PREV_STEP > NO_MATCH_INDEX) {
 prev = settings[currentIndex - PREV_STEP];
}
let next;
if (currentIndex + PREV_STEP < settings.length) {
 next = settings[currentIndex + PREV_STEP];
}
---

<!DOCTYPE html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<title>{frontmatter.title}</title>
		<style>
			@font-face {
				font-family: Inter;
				src: url("/Inter.ttf");
			}
		</style>
		<script>
			import "uno.css";

			const menuButton = document.querySelector("#mobileMenu"),
			 navigation = document.querySelector("#navigation");
			if (menuButton && navigation) {
				menuButton.addEventListener("click", () => {
					navigation.classList.toggle("translate-x-0");
					navigation.classList.toggle("-translate-x-full");
				});
			}
		</script>
	</head>
	<body class='flex flex-col gap-3 transition'>
		<GeneralMenu client:load url={onlineVersion} />
		<div class='lg:hidden flex justify-center items-center w-full'>
			<a href={prev?.url}>
				<span class='py-2 px-4'>
					{prev ? `< ${prev.frontmatter.title}` : ""}
				</span>
			</a>
			<span id='mobileMenu' class='py-2 px-4 cursor-pointer'>Menu</span>
			<a href={next?.url}>
				<span class='py-2 px-4'>
					{next ? `${next.frontmatter.title} >` : ""}
				</span>
			</a>
		</div>
		<div class='flex justify-around w-screen h-full overflow-hidden relative'>
			<div class='hidden lg:block'>
				<HelpMenu settings={settings} />
			</div>
			<div
				id='navigation'
				class='block lg:hidden absolute w-full z-20 bg-gray-100/10 backdrop-blur-md transform -translate-x-full lg:translate-x-0 transition'
			>
				<HelpMenu settings={settings} />
			</div>
			<article
				class='overflow-y-auto flex flex-col w-full p-2 lg:w-200 mx-4 lg:m-0 bg-white dark:bg-dark-600 dark:color-light rounded-lg'
			>
				<slot />
			</article>
			<div class='hidden lg:block'></div>
		</div>
	</body>
</html>
