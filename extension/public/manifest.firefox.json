{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "TabDash",
  "version": "0.4.2",
  "description": "__MSG_extensionDesc__",
  "author": "Wesley Urban",
  "homepage_url": "https://tabdash.wesley.fyi",
  "default_locale": "en",
  "icons": {
    "16": "tabdash_16.png",
    "48": "tabdash_48.png",
    "128": "tabdash_128.png"
  },
  "action": {
    "default_icon": "tabdash_128.png",
    "default_title": "__MSG_extensionName__"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "geolocation",
    "search",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{494a0d1f-1baf-4f28-95bc-77d20a3f25a0}",
      "strict_min_version": "115.0"
    }
  }
}
