{
  "name": "tabdash",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "extension",
    "companion",
    "backend"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check",
    "prepare": "lefthook install --force",
    "build": "bun run --filter \"*\" build",
    "dev:extension": "bun --filter @ur-wesley/tabdash-extension dev",
    "dev:companion": "bun --filter @ur-wesley/tabdash-companion dev",
    "dev:backend": "bun --filter tabdash_backend dev"
  },
  "devDependencies": {
    "@corvu/utils": "^0.4.2",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "^7.0.0"
  },
  "packageManager": "bun@1.4.2"
}
